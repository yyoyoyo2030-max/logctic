# ================================================
# نظام إدارة اللوجستيك - إعدادات البيئة
# ================================================
# قم بنسخ هذا الملف وتسميته ".env" وقم بتعديل القيم أدناه.

# ------------------------------------------------
# إعدادات النظام الأساسية
# ------------------------------------------------
# ENVIRONMENT: إما "local" للكمبيوتر الشخصي أو "production" للاستضافة
ENVIRONMENT=production

# SITE_URL: رابط الموقع بدون علامة / في النهاية
SITE_URL=http://your-vps-ip-or-domain

# ------------------------------------------------
# بيانات الاتصال بقاعدة البيانات
# ------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password_here
DB_NAME=logistic_db

# ------------------------------------------------
# إعدادات رفع الملفات (اختياري، يعمل افتراضيا بشكل جيد)
# ------------------------------------------------
UPLOAD_MAX_SIZE=10M
